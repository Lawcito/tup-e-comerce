{
  "name": "e-comerce",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "start:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "android": "rm -rf ./android && npm run build && npx cap add android && npx cap sync android && npx cap open android",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "prepare": "husky",
    "lint:staged": "lint-staged",
    "analyze:build": "ng build --stats-json",
    "analyze:bundle": "esbuild-visualizer --metadata ./dist/e-comerce/stats.json --filename ./dist/esbuild-report.html",
    "analyze:lighthouse": "lhci autorun",
    "analyze:all": "npm run analyze:build && npm run analyze:bundle && npm run analyze:lighthouse"
  },
  "private": true,
  "packageManager": "npm@11.5.2",
  "dependencies": {
    "@angular/animations": "^21.2.9",
    "@angular/cdk": "^21.2.7",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.7",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.14",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@sentry/angular": "^10.67.0",
    "firebase": "^12.13.0",
    "i18next": "^26.3.0",
    "normalize.css": "^8.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.4.0",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ]
  }
}